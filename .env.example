# ════════════════════════════════════════════════════════════
# ToopSet — Environment Variables Reference
# ════════════════════════════════════════════════════════════
# Copy relevant vars to the appropriate service env file:
#   backend/  → backend/.env
#   frontend/ → frontend/.env.local
#   Docker    → .env (at project root, for compose variable substitution)
# ════════════════════════════════════════════════════════════

# ── Docker Infrastructure (root .env) ─────────────────────
COMPOSE_PROJECT_NAME=toopset
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── PostgreSQL (backend/.env) ─────────────────────────────
POSTGRES_DB=toopset
POSTGRES_USER=toopset
POSTGRES_PASSWORD=toopset_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Test PostgreSQL (backend/.env, integration tests) ─────
TEST_POSTGRES_DB=toopset_test

# ── Redis (backend/.env) ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT (backend/.env) ────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Connection Pool (backend/.env) ────────────────────────
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ── Payment (backend/.env, mock = no real gateway) ────────
PAYMENT_GATEWAY=mock

# ── SMS (backend/.env, mock = logs code to console) ───────
SMS_PROVIDER=mock

# ── Monitoring: Backend (backend/.env) ────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── Monitoring: Frontend (frontend/.env.local) ────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Frontend (frontend/.env.local) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_NESHAN_API_KEY=your-neshan-service-api-key

# ── Logging (backend/.env) ────────────────────────────────
LOG_LEVEL=INFO

# ── Bundle Analyzer (frontend/.env.local) ─────────────────
ANALYZE=false

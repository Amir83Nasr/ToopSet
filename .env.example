# ══════════════════════════════════════════════════════════════════════════════
# ToopSet — Environment Reference
# ══════════════════════════════════════════════════════════════════════════════
# Not read by the app — each layer reads its own file:
#   backend/.env.example  →  backend/.env        (API, dev or prod)
#   frontend/.env.example →  frontend/.env.local (Next.js)
#   .env                  →  Docker Compose      (root, DB + Redis)
#
# SECRET_KEY:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ══════════════════════════════════════════════════════════════════════════════


# ── BACKEND (required at startup) ─────────────────────────────────────────────
# DATABASE_URL              postgresql+asyncpg://user:pass@host/db  (cloud, else POSTGRES_*)
# REDIS_URL                 rediss://…                              (cloud, else REDIS_HOST)
# SECRET_KEY                64+ char random key (min 32)
# APP_ENVIRONMENT           development | production
# CORS_ORIGINS              comma-separated origins ("*" dev only)
# PAYMENT_GATEWAY           mock | zibal   (zibal → ZIBAL_MERCHANT, ZIBAL_CALLBACK_URL)
# SMS_PROVIDER              mock | smsir   (smsir → SMS_API_URL, SMS_API_KEY, SMS_TEMPLATE_ID)
# REFRESH_COOKIE_SECURE     true in production (SAMESITE must be "none" there)
# PARSPACK_ENDPOINT_URL     https://<region>.parspack.com  (S3 storage; omit → local disk)
# PARSPACK_ACCESS_KEY       ParsPack IAM access key
# PARSPACK_SECRET_KEY       ParsPack IAM secret key
# PARSPACK_BUCKET_NAME      target bucket name

# ── FRONTEND (inlined at build time) ──────────────────────────────────────────
# NEXT_PUBLIC_API_URL        backend URL, no trailing slash
# NEXT_PUBLIC_NESHAN_API_KEY Neshan map web key

# ── DOCKER COMPOSE (root .env) ────────────────────────────────────────────────
# COMPOSE_PROJECT_NAME  optional, default toopset
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_PORT
# REDIS_PORT

# ── RAILWAY DEPLOYMENT (set in Railway dashboard, never in files) ─────────────
# Backend service (builds backend/Dockerfile via backend/railway.json).
# The app fails fast at startup if these are missing/wrong (validate_env in
# app/core/config.py), so every one below is REQUIRED for production:
#
#   DATABASE_URL          Neon/Postgres add-on connection string (postgresql://…,
#                         auto-converts to asyncpg). Also drives `alembic upgrade`
#                         in docker-entrypoint.sh before uvicorn starts.
#   REDIS_URL             Upstash/Redis add-on connection string (rediss://…).
#   SECRET_KEY            `python3 -c "import secrets; print(secrets.token_urlsafe(64))"`
#   APP_ENVIRONMENT       production
#   CORS_ORIGINS          comma-separated frontend origin(s) — "*" is rejected in prod
#   REFRESH_COOKIE_SECURE true   (HTTP-only refresh cookie over HTTPS)
#   REFRESH_COOKIE_SAMESITE none (cross-origin: Vercel frontend → Railway backend)
#   PAYMENT_GATEWAY       real provider id ("mock" is rejected in production)
#   SMS_PROVIDER          real provider id ("mock" is rejected in production)
#   AUTO_MIGRATE          true (default) — entrypoint runs alembic upgrade head
#
# Frontend service (builds frontend/Dockerfile via frontend/railway.json),
# NEXT_PUBLIC_* values are inlined at BUILD time — rebuild on change:
#   NEXT_PUBLIC_API_URL        backend Railway URL, no trailing slash
#   NEXT_PUBLIC_NESHAN_API_KEY Neshan map web key

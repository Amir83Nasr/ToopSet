# ══════════════════════════════════════════════════════════════════════════════
# ToopSet — Environment Variable Reference (v1.1.0)
# ══════════════════════════════════════════════════════════════════════════════
# This file documents every env var the project reads.
#
# Layout:
#   ┌─────────────────────────────────────────────────────────────────────────┐
#   │ BACKEND (Railway / Docker) — set as Railway dashboard env vars          │
#   └─────────────────────────────────────────────────────────────────────────┘
#     PRODUCTION REQUIRED     → must be set for production deployment
#     PRODUCTION OPTIONAL     → optional, has a safe default
#     DEVELOPMENT ONLY        → for local dev / Docker Compose only
#
#   ┌─────────────────────────────────────────────────────────────────────────┐
#   │ FRONTEND (Vercel)       — set as Vercel dashboard env vars             │
#   └─────────────────────────────────────────────────────────────────────────┘
#
# Backend reads backend/.env via pydantic-settings. Frontend reads
# frontend/.env.local via Next.js. Docker Compose reads root ./.env.
#
# ALWAYS generate a strong SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND — Database
# ══════════════════════════════════════════════════════════════════════════════

# ── PRODUCTION REQUIRED ─────────────────────────────────────────────────────
# Neon / other cloud PostgreSQL connection string.
# Takes priority over individual POSTGRES_* fields when non-empty.
# Example:
#   DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.aws.neon.tech/db?sslmode=require
# DATABASE_URL=

# ── DEVELOPMENT ONLY (if DATABASE_URL is not set) ───────────────────────────
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=toopset
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=toopset


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND — Cache
# ══════════════════════════════════════════════════════════════════════════════

# ── PRODUCTION REQUIRED ─────────────────────────────────────────────────────
# Upstash / other cloud Redis connection string (rediss:// for TLS).
# Takes priority over individual REDIS_* fields when non-empty.
# Example:
#   REDIS_URL=rediss://default:token@xxx.upstash.io:6379
# REDIS_URL=

# ── DEVELOPMENT ONLY (if REDIS_URL is not set) ──────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND — Auth / JWT
# ══════════════════════════════════════════════════════════════════════════════

# ── PRODUCTION REQUIRED ─────────────────────────────────────────────────────
# SECRET_KEY=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))">

# ── PRODUCTION REQUIRED (must match production values below) ────────────────
# APP_ENVIRONMENT=production
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=none

# ── PRODUCTION OPTIONAL (sane defaults) ─────────────────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# SECRET_KEY_PREVIOUS=                        # key rotation: old key to accept expired tokens
# BOOTSTRAP_ADMIN_SECRET=                     # one-time secret to create the first admin
# JWT_ISSUER=toopset-api
# JWT_AUDIENCE=toopset-client
# CLOCK_SKEW_SECONDS=10
# SESSION_CLEANUP_INTERVAL_DAYS=30


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND — CORS
# ══════════════════════════════════════════════════════════════════════════════

# ── PRODUCTION REQUIRED ─────────────────────────────────────────────────────
# Comma-separated, no spaces. Example:
# CORS_ORIGINS=https://toopset.vercel.app,https://toopset.com

# ── DEVELOPMENT ONLY ────────────────────────────────────────────────────────
# CORS_ORIGINS=*


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND — Connection Pool
# ══════════════════════════════════════════════════════════════════════════════

# ── PRODUCTION OPTIONAL ─────────────────────────────────────────────────────
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=5


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND — Integrations
# ══════════════════════════════════════════════════════════════════════════════

# ── PRODUCTION REQUIRED (replace mock before going live) ────────────────────
# PAYMENT_GATEWAY=mock                        # e.g. zarinpal, idpay
# SMS_PROVIDER=mock                           # e.g. kavenegar, farazsms


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND — Logging & Monitoring
# ══════════════════════════════════════════════════════════════════════════════

# ── PRODUCTION OPTIONAL ─────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── PRODUCTION OPTIONAL (OpenTelemetry) ─────────────────────────────────────
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=toopset-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SAMPLE_RATE=0.1


# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND (Vercel)
# ══════════════════════════════════════════════════════════════════════════════
# Set these in Vercel dashboard → Project Settings → Environment Variables.
# NEXT_PUBLIC_* vars are inlined at build time and visible in the browser.
# ══════════════════════════════════════════════════════════════════════════════

# ── PRODUCTION REQUIRED ─────────────────────────────────────────────────────
# Railway backend URL (no trailing slash):
# NEXT_PUBLIC_API_URL=https://toopset-backend.railway.app

# ── PRODUCTION REQUIRED ─────────────────────────────────────────────────────
# Neshan map web API key (public, visible in browser):
# NEXT_PUBLIC_NESHAN_API_KEY=web.xxx...

# ── PRODUCTION OPTIONAL ─────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=                     # frontend error tracking
# SENTRY_DSN=                                 # server-side (SSR) error tracking
# ENABLE_PWA=true                             # false to disable service worker


# ══════════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE — set in root ./.env (Docker only)
# ══════════════════════════════════════════════════════════════════════════════

# COMPOSE_PROJECT_NAME=toopset
# POSTGRES_PORT=5432
# REDIS_PORT=6379

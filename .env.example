# ══════════════════════════════════════════════════════════════════════════════
# ToopSet — Environment Variable Reference (v1.1.0)
# ══════════════════════════════════════════════════════════════════════════════
#
# This file documents every env var the project reads across all environments.
# It is NOT used by the application directly — each layer reads its own .env.
#
# Layout:
#   ┌─────────────────────────────────────────────────────────────────────────┐
#   │ BACKEND      — set in Railway dashboard (Production / Staging)          │
#   └─────────────────────────────────────────────────────────────────────────┘
#     REQUIRED       → must be set for the service to start
#     OPTIONAL       → has a safe default, override only if needed
#
#   ┌─────────────────────────────────────────────────────────────────────────┐
#   │ FRONTEND     — set in Vercel dashboard (Production / Preview)           │
#   └─────────────────────────────────────────────────────────────────────────┘
#
# ALWAYS generate a strong SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND (Railway)
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL  REQUIRED (production)  postgresql+asyncpg://user:pass@host/db
#
# For local dev, use individual POSTGRES_* vars instead (see backend/.env.example).

# ── Cache ──────────────────────────────────────────────────────────────────────
# REDIS_URL     REQUIRED (production)  rediss://default:token@host:6379
#
# For local dev, use individual REDIS_* vars instead (see backend/.env.example).

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# SECRET_KEY                        REQUIRED  64+ char url-safe base64 key
# APP_ENVIRONMENT                   REQUIRED  "development" or "production"
# ACCESS_TOKEN_EXPIRE_MINUTES       OPTIONAL  Default: 30
# REFRESH_TOKEN_EXPIRE_DAYS         OPTIONAL  Default: 7
# REFRESH_COOKIE_SECURE             REQUIRED  true in production
# REFRESH_COOKIE_SAMESITE           REQUIRED  "none" in production (cross-origin)
# SECRET_KEY_PREVIOUS               OPTIONAL  Old key for rotation
# BOOTSTRAP_ADMIN_SECRET            OPTIONAL  One-time admin creation
# JWT_ISSUER                        OPTIONAL  Default: toopset-api
# JWT_AUDIENCE                      OPTIONAL  Default: toopset-client
# CLOCK_SKEW_SECONDS                OPTIONAL  Default: 10
# SESSION_CLEANUP_INTERVAL_DAYS     OPTIONAL  Default: 30

# ── Connection Pool ────────────────────────────────────────────────────────────
# DB_POOL_SIZE                      OPTIONAL  Default: 20
# DB_MAX_OVERFLOW                   OPTIONAL  Default: 10
# DB_POOL_RECYCLE                   OPTIONAL  Default: 1800
# DB_POOL_TIMEOUT                   OPTIONAL  Default: 5

# ── Integrations ──────────────────────────────────────────────────────────────
# PAYMENT_GATEWAY                   REQUIRED  "mock" or real (zarinpal, idpay)
# SMS_PROVIDER                      REQUIRED  "mock" or real (kavenegar, farazsms)

# ── CORS ───────────────────────────────────────────────────────────────────────
# CORS_ORIGINS                      REQUIRED  Comma-separated origins (no spaces)
#                                            Example: https://toopset.vercel.app
#                                            Use "*" for development only.

# ── Logging & Monitoring ───────────────────────────────────────────────────────
# LOG_LEVEL                         OPTIONAL  Default: INFO
# SENTRY_DSN                        OPTIONAL  Error tracking
# SENTRY_TRACES_SAMPLE_RATE         OPTIONAL  Default: 0.2

# ── OpenTelemetry (optional) ───────────────────────────────────────────────────
# OTEL_ENABLED                      OPTIONAL  Default: false
# OTEL_SERVICE_NAME                 OPTIONAL  Default: toopset-api
# OTEL_EXPORTER_OTLP_ENDPOINT       OPTIONAL  Default: http://localhost:4317
# OTEL_SAMPLE_RATE                  OPTIONAL  Default: 0.1

# ── Profiler (optional) ────────────────────────────────────────────────────────
# PROFILER_ENABLED                  OPTIONAL  Default: false
# PROFILER_SLOW_REQUEST_THRESHOLD_MS OPTIONAL  Default: 500.0


# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND (Vercel)
# ══════════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_* vars are inlined at build time and visible in the browser.
# ══════════════════════════════════════════════════════════════════════════════

# NEXT_PUBLIC_API_URL               REQUIRED  Railway backend URL (no trailing slash)
#                                            Preview: https://staging.railway.app
#                                            Production: https://prod.railway.app

# NEXT_PUBLIC_NESHAN_API_KEY        REQUIRED  Neshan map web API key (public)

# NEXT_PUBLIC_SENTRY_DSN            OPTIONAL  Frontend error tracking
# SENTRY_DSN                        OPTIONAL  Server-side (SSR) error tracking

# ENABLE_PWA                        OPTIONAL  Default: true — set false to disable PWA
# ANALYZE                           OPTIONAL  Default: false — bundle analyzer


# ══════════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE — set in root ./.env (Docker only)
# ══════════════════════════════════════════════════════════════════════════════

# COMPOSE_PROJECT_NAME              OPTIONAL  Default: toopset
# POSTGRES_PORT                     OPTIONAL  Default: 5432
# REDIS_PORT                        OPTIONAL  Default: 6379

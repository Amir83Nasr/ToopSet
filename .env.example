# ══════════════════════════════════════════════════════════════════════════════
# ToopSet — Environment Variables Reference (single source of truth)
# ══════════════════════════════════════════════════════════════════════════════
# This file documents EVERY environment variable the project reads.
# It is the only .env.example — copy each section to its target file:
#
#   • Docker section   → ./.env                 (root, for `docker compose`)
#   • Backend sections → ./backend/.env
#   • Frontend section → ./frontend/.env.local
#
# `docker compose` auto-loads the root ./.env. The backend reads
# backend/.env via pydantic-settings; the frontend reads
# frontend/.env.local via Next.js. There is no single .env that feeds
# all three — copy the relevant block into each file.
#
# Safe defaults below are fine for local development. For production,
# every value marked <<REQUIRED>> MUST be changed to a strong value.
# ══════════════════════════════════════════════════════════════════════════════


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ DOCKER — copy to ./.env (project root)                                     │
# └────────────────────────────────────────────────────────────────────────────┘

# ── Docker Compose (root .env) ────────────────────────────────────────────────
# Only these are substituted by compose.yml. Ports also have
# built-in defaults, so the root .env is optional for local dev.
COMPOSE_PROJECT_NAME=toopset
POSTGRES_PORT=5432
REDIS_PORT=6379

# BACKEND_PORT / FRONTEND_PORT are NOT used by compose.yml — they are
# reference values for the Makefile targets (UVICORN_PORT / NEXT_PORT).
BACKEND_PORT=8000
FRONTEND_PORT=3000


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ BACKEND — copy to ./backend/.env                                           │
# └────────────────────────────────────────────────────────────────────────────┘

# ── PostgreSQL (backend/.env) ─────────────────────────────────────────────────
POSTGRES_DB=toopset                        # <<REQUIRED>>
POSTGRES_USER=toopset                      # <<REQUIRED>>
POSTGRES_PASSWORD=change-me                # <<REQUIRED>> strong random password in production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Integration tests use a hardcoded DB URL (backend/tests/conftest.py):
#   postgresql+asyncpg://toopset:toopset_secret@localhost:5432/toopset_test
# Create the `toopset_test` database before running `make test`.

# ── Redis (backend/.env) ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                            # set if your Redis requires auth
REDIS_SSL=false                            # true for Redis over TLS

# ── JWT & Auth (backend/.env) ─────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key # <<REQUIRED>> generate with:
                                           #   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY_PREVIOUS=                        # set during key rotation to accept old tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false                 # false for local HTTP, true for production HTTPS
APP_ENVIRONMENT=development                 # development | production (drives startup validation)
BOOTSTRAP_ADMIN_SECRET=                     # one-time secret to bootstrap the first admin

# ── Connection Pool (backend/.env) ────────────────────────────────────────────
DB_POOL_SIZE=20                            # min 10 for production
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=5

# ── Payment (backend/.env, mock = no real gateway) ────────────────────────────
PAYMENT_GATEWAY=mock                       # set to your real gateway for production

# ── SMS (backend/.env, mock = logs code to console) ───────────────────────────
SMS_PROVIDER=mock                          # set to your real provider for production

# ── CORS (backend/.env) ───────────────────────────────────────────────────────
# Comma-separated allowed origins. Do NOT use "*" in production.
# Example: https://toopset.example.com,https://admin.toopset.example.com
CORS_ORIGINS=*

# ── Monitoring: Backend (backend/.env) ────────────────────────────────────────
SENTRY_DSN=                                # Sentry DSN for backend error tracking
SENTRY_TRACES_SAMPLE_RATE=0.2              # 0.0 – 1.0; lower in high-throughput prod

# ── Logging (backend/.env) ────────────────────────────────────────────────────
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR | CRITICAL


# ── Advanced (backend/.env, optional — sane defaults in code) ─────────────────
# Uncomment only when you need to override the defaults.

# OpenTelemetry
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=toopset-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SAMPLE_RATE=0.1

# Request profiler
# PROFILER_ENABLED=false
# PROFILER_SLOW_REQUEST_THRESHOLD_MS=500.0
# PROFILER_LOG_SQL_QUERIES=true

# SLO / error-budget targets
# SLO_AVAILABILITY_TARGET=99.9
# SLO_LATENCY_P99_TARGET_MS=500.0
# SLO_ERROR_RATE_TARGET=1.0


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ FRONTEND — copy to ./frontend/.env.local                                   │
# └────────────────────────────────────────────────────────────────────────────┘

# ── API (frontend/.env.local) ─────────────────────────────────────────────────
# On LAN, the browser auto-resolves loopback hosts to <LOCAL_IP>:8000
# (see frontend/lib/api.ts getApiBase), so localhost works from a phone.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Dev LAN access (frontend/.env.local) ──────────────────────────────────────
# Comma-separated LAN IPs allowed for dev HMR from other devices
# (e.g. your phone). Set before running the dev server.
# ALLOWED_DEV_ORIGINS=192.168.1.20

# ── Neshan Map (frontend/.env.local) ──────────────────────────────────────────
# Optional: maps fall back to CartoDB tiles if not set.
NEXT_PUBLIC_NESHAN_API_KEY=your-neshan-service-api-key

# ── Monitoring: Frontend (frontend/.env.local) ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                     # Sentry DSN for frontend error tracking

# ── Bundle Analyzer (frontend/.env.local) ─────────────────────────────────────
ANALYZE=false                              # true to run `next build` with the analyzer

# ── PWA / Service Worker (frontend/.env.local) ────────────────────────────────
# Set ENABLE_PWA=false to completely disable the service worker (no-op SW).
ENABLE_PWA=true                            # false to disable PWA entirely
# Only relevant in development mode: set ENABLE_PWA_DEV=true to test the
# service worker locally (requires a production build).
ENABLE_PWA_DEV=false                       # true to test SW in dev

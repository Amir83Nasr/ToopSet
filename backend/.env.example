# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=toopset
POSTGRES_USER=toopset
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Test PostgreSQL (must exist for integration tests) ───
TEST_POSTGRES_DB=toopset_test

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Connection Pool ───────────────────────────────────────
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ── Payment (mock = no real gateway) ──────────────────────
PAYMENT_GATEWAY=mock

# ── SMS (mock = logs code to console) ─────────────────────
SMS_PROVIDER=mock

# ── Monitoring ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO

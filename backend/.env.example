# ToopSet — Backend Environment
# Copy to backend/.env for local dev. Cloud: set DATABASE_URL /
# REDIS_URL instead of the *_HOST fields below.

# ─── DATABASE / CACHE ─────────────────────────────────────
POSTGRES_DB=toopset
POSTGRES_USER=toopset
POSTGRES_PASSWORD=toopset_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://toopset:toopset_secret@localhost:5432/toopset
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
# REDIS_SSL=false

# ─── AUTH / JWT / COOKIES ─────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
# SECRET_KEY_PREVIOUS=
APP_ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_ISSUER=toopset-api
# JWT_AUDIENCE=toopset-client
# CLOCK_SKEW_SECONDS=30
# SESSION_CLEANUP_INTERVAL_DAYS=30
# BOOTSTRAP_ADMIN_SECRET=
# ALLOW_AUDIT_LOG_DELETION=false
# AUTO_MIGRATE=true
# REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ─── DATABASE POOL ────────────────────────────────────────
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=5

# ─── PAYMENT / ZIBAL ──────────────────────────────────────
PAYMENT_GATEWAY=mock
# ZIBAL_MERCHANT=
# ZIBAL_BASE_URL=https://gateway.zibal.ir
# ZIBAL_CALLBACK_URL=https://api.toopset.ir/api/v1/payments/zibal/callback
# PAYMENT_RESULT_URL=https://toopset.ir/book/payment/callback

# ─── SMS ──────────────────────────────────────────────────
SMS_PROVIDER=mock
# SMS_API_URL=
# SMS_API_KEY=
# SMS_TEMPLATE_ID=
# SMS_BOOKING_TEMPLATE_ID=625366

# ─── CORS / LOGGING ───────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_FILE_DIR=/app/logs

# ─── PARSPACK S3 OBJECT STORAGE ───────────────────────────
# (optional; omit to use local disk)
PARSPACK_ENDPOINT_URL=http://c228415.parspack.net
PARSPACK_PUBLIC_BASE_URL=https://media.toopset.ir/c228415
PARSPACK_ACCESS_KEY=your-access-key
PARSPACK_SECRET_KEY=your-secret-key
PARSPACK_BUCKET_NAME=c228415

# ─── MONITORING / SENTRY ──────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── OBSERVABILITY / PROFILER / SLO ───────────────────────
# CORRELATION_ID_HEADER=X-Request-ID
# CORRELATION_ID_LENGTH=36
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=toopset-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_CONSOLE=false
# OTEL_SQLALCHEMY_ENABLED=true
# OTEL_REDIS_ENABLED=true
# OTEL_HTTP_CLIENT_ENABLED=true
# OTEL_SAMPLE_RATE=0.1
# OTEL_MAX_EXPORT_BATCH_SIZE=512
# OTEL_MAX_QUEUE_SIZE=2048
# PROFILER_ENABLED=false
# PROFILER_SLOW_REQUEST_THRESHOLD_MS=500.0
# PROFILER_LOG_SQL_QUERIES=true
# PROFILER_MAX_QUERIES_PER_REQUEST=50
# SLO_AVAILABILITY_TARGET=99.9
# SLO_LATENCY_P99_TARGET_MS=500.0
# SLO_ERROR_RATE_TARGET=1.0

# ════════════════════════════════════════════════════════════
# ToopSet — Environment Variables
# ════════════════════════════════════════════════════════════
#
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# Safe defaults are provided for local development.  For production,
# every variable marked <<REQUIRED>> MUST be set to a strong value.
# ════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=toopset                       # <<REQUIRED>>
POSTGRES_USER=toopset                     # <<REQUIRED>>
POSTGRES_PASSWORD=change-me               # <<REQUIRED>> Use a strong random password in production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Test PostgreSQL (must exist for integration tests) ───
TEST_POSTGRES_DB=toopset_test

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                           # Set this if your Redis requires auth
REDIS_SSL=false                            # Set true for Redis over TLS

# ── JWT ───────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key # <<REQUIRED>> Generate with:
                                           #   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false                 # false for local HTTP, true for production HTTPS

# ── Connection Pool ───────────────────────────────────────
DB_POOL_SIZE=20                            # Min 10 for production
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=5

# ── Payment (mock = no real gateway) ──────────────────────
PAYMENT_GATEWAY=mock                       # Set to your real gateway for production

# ── SMS (mock = logs code to console) ─────────────────────
SMS_PROVIDER=mock                          # Set to your real provider for production

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins.  Do NOT use "*" in production.
# Example: https://toopset.example.com,https://admin.toopset.example.com
CORS_ORIGINS=*

# ── Monitoring ────────────────────────────────────────────
SENTRY_DSN=                                # Set your Sentry DSN for error tracking
SENTRY_TRACES_SAMPLE_RATE=0.2              # 0.0 – 1.0; lower in high-throughput prod

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR | CRITICAL

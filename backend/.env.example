# ══════════════════════════════════════════════════════════════
# ToopSet — Backend Environment
# Copy to backend/.env for local dev. Cloud: set DATABASE_URL /
# REDIS_URL instead of the *_HOST fields below.
# ──────────────────────────────────────────────────────────────

# ── Database / Cache ──────────────────────────────────────────
POSTGRES_DB=toopset
POSTGRES_USER=toopset
POSTGRES_PASSWORD=toopset_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth ──────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
APP_ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ── Integrations (mock = no real service) ─────────────────────
PAYMENT_GATEWAY=mock
# ZIBAL_CALLBACK_URL=https://api.toopset.ir/api/v1/payments/zibal/callback
# PAYMENT_RESULT_URL=https://toopset.ir/book/payment/callback
SMS_PROVIDER=mock

# ── CORS / Logging ────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── ParsPack S3 Object Storage (optional; omit to use local disk) ──
PARSPACK_ENDPOINT_URL=http://c228415.parspack.net
PARSPACK_PUBLIC_BASE_URL=https://media.toopset.ir/c228415
PARSPACK_ACCESS_KEY=your-access-key
PARSPACK_SECRET_KEY=your-secret-key
PARSPACK_BUCKET_NAME=c228415

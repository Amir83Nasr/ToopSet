# ══════════════════════════════════════════════════════════════
# ToopSet — Backend Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this to backend/.env for local development.
# ──────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Cloud: set DATABASE_URL in Railway dashboard (takes priority)
# Local: uncomment the POSTGRES_* fields
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db?sslmode=require
POSTGRES_DB=toopset
POSTGRES_USER=toopset
POSTGRES_PASSWORD=toopset_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Cache ────────────────────────────────────────────────────
# Cloud: set REDIS_URL in Railway dashboard (takes priority)
# REDIS_URL=rediss://default:token@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false

# ── Auth / JWT ───────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
APP_ENVIRONMENT=development
# SECRET_KEY_PREVIOUS=
# BOOTSTRAP_ADMIN_SECRET=
# JWT_ISSUER=toopset-api
# JWT_AUDIENCE=toopset-client
# CLOCK_SKEW_SECONDS=10
# SESSION_CLEANUP_INTERVAL_DAYS=30

# ── Connection Pool ──────────────────────────────────────────
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=5

# ── Integrations (mock = no real gateway) ────────────────────
PAYMENT_GATEWAY=mock
SMS_PROVIDER=mock

# ── CORS ─────────────────────────────────────────────────────
# Use "*" for local dev (any origin), comma-separated URLs for production
CORS_ORIGINS=*

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2

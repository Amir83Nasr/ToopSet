{
  "__inputs": [],
  "__requires": [],
  "title": "ToopSet — API Observability",
  "uid": "toopset-api-obs",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["toopset", "api"],
  "timezone": "browser",
  "panels": [
    {
      "collapsed": true,
      "title": "HTTP Traffic",
      "panels": [
        {
          "id": 1,
          "title": "Requests per Second — by Status",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "reqps", "min": 0 }
          },
          "targets": [
            {
              "expr": "rate(http_requests_total[5m])",
              "legendFormat": "{{method}} {{path}} {{status}}"
            }
          ]
        },
        {
          "id": 2,
          "title": "HTTP Request Duration — P50 / P95 / P99",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "s" }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "p99"
            }
          ]
        },
        {
          "id": 3,
          "title": "HTTP Error Rate (4xx + 5xx)",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "reqps", "min": 0 }
          },
          "targets": [
            {
              "expr": "rate(http_errors_total[5m])",
              "legendFormat": "{{status}}"
            }
          ]
        },
        {
          "id": 4,
          "title": "In-Flight Requests",
          "type": "gauge",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "min": 0,
              "max": 100,
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 50 } ] }
            }
          },
          "targets": [
            {
              "expr": "http_requests_in_progress"
            }
          ]
        },
        {
          "id": 5,
          "title": "Request Size Distribution",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "bytes" }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(toopset_request_size_bytes_bucket[5m]))",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(toopset_request_size_bytes_bucket[5m]))",
              "legendFormat": "p95"
            }
          ]
        },
        {
          "id": 6,
          "title": "Response Size Distribution",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "bytes" }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(toopset_response_size_bytes_bucket[5m]))",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(toopset_response_size_bytes_bucket[5m]))",
              "legendFormat": "p95"
            }
          ]
        }
      ]
    },
    {
      "collapsed": true,
      "title": "Database & Cache",
      "panels": [
        {
          "id": 7,
          "title": "DB Query Count per Request",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none", "min": 0 }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(toopset_db_query_count_bucket[5m]))",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(toopset_db_query_count_bucket[5m]))",
              "legendFormat": "p95"
            }
          ]
        },
        {
          "id": 8,
          "title": "DB Query Duration (cumulative per request)",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "ms" }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(toopset_db_query_duration_ms_bucket[5m]))",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(toopset_db_query_duration_ms_bucket[5m]))",
              "legendFormat": "p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(toopset_db_query_duration_ms_bucket[5m]))",
              "legendFormat": "p99"
            }
          ]
        },
        {
          "id": 9,
          "title": "Redis Ops per Request",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none", "min": 0 }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(toopset_redis_op_count_bucket[5m]))",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(toopset_redis_op_count_bucket[5m]))",
              "legendFormat": "p95"
            }
          ]
        },
        {
          "id": 10,
          "title": "Redis Op Duration (cumulative per request)",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "ms" }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(toopset_redis_op_duration_ms_bucket[5m]))",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(toopset_redis_op_duration_ms_bucket[5m]))",
              "legendFormat": "p95"
            }
          ]
        },
        {
          "id": 11,
          "title": "Cache Hit / Miss Ratio",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none" }
          },
          "targets": [
            {
              "expr": "rate(toopset_cache_hits_total[5m])",
              "legendFormat": "hits"
            },
            {
              "expr": "rate(toopset_cache_misses_total[5m])",
              "legendFormat": "misses"
            }
          ]
        },
        {
          "id": 12,
          "title": "DB Connection Pool",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none", "min": 0 }
          },
          "targets": [
            {
              "expr": "toopset_db_pool_size{state=\"checked_in\"}",
              "legendFormat": "checked_in"
            },
            {
              "expr": "toopset_db_pool_size{state=\"checked_out\"}",
              "legendFormat": "checked_out"
            },
            {
              "expr": "toopset_db_pool_size{state=\"overflow\"}",
              "legendFormat": "overflow"
            }
          ]
        },
        {
          "id": 13,
          "title": "Cache Memory Usage",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "bytes" }
          },
          "targets": [
            {
              "expr": "toopset_cache_memory_bytes"
            }
          ]
        }
      ]
    },
    {
      "collapsed": true,
      "title": "Business KPIs",
      "panels": [
        {
          "id": 14,
          "title": "Registered Users",
          "type": "stat",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none" }
          },
          "targets": [
            {
              "expr": "toopset_db_users_total"
            }
          ]
        },
        {
          "id": 15,
          "title": "Active Courts",
          "type": "stat",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none" }
          },
          "targets": [
            {
              "expr": "toopset_active_courts_total"
            }
          ]
        },
        {
          "id": 16,
          "title": "Today's Bookings & Revenue",
          "type": "stat",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none" }
          },
          "targets": [
            {
              "expr": "toopset_today_bookings_total",
              "legendFormat": "Bookings"
            },
            {
              "expr": "toopset_today_revenue_toman",
              "legendFormat": "Revenue (Toman)"
            }
          ]
        },
        {
          "id": 17,
          "title": "Bookings by Status",
          "type": "bargauge",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none" }
          },
          "targets": [
            {
              "expr": "toopset_bookings_by_status",
              "legendFormat": "{{status}}"
            }
          ]
        },
        {
          "id": 18,
          "title": "Booking Success Ratio",
          "type": "gauge",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 } ] }
            }
          },
          "targets": [
            { "expr": "toopset_booking_success_ratio" }
          ]
        },
        {
          "id": 19,
          "title": "Payment Failure Ratio",
          "type": "gauge",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.15 } ] }
            }
          },
          "targets": [
            { "expr": "toopset_payment_failure_ratio" }
          ]
        },
        {
          "id": 20,
          "title": "Active Sessions & Token Rotations",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none" }
          },
          "targets": [
            {
              "expr": "toopset_active_sessions",
              "legendFormat": "active sessions"
            },
            {
              "expr": "rate(toopset_refresh_token_rotations_total[5m])",
              "legendFormat": "token rotations"
            }
          ]
        },
        {
          "id": 21,
          "title": "OTP Lockouts & Uploads",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "none" }
          },
          "targets": [
            {
              "expr": "rate(toopset_otp_lockouts_total[5m])",
              "legendFormat": "OTP lockouts"
            },
            {
              "expr": "rate(toopset_upload_count_total[5m])",
              "legendFormat": "uploads {{type}}"
            }
          ]
        }
      ]
    },
    {
      "collapsed": true,
      "title": "Request Profiling",
      "panels": [
        {
          "id": 22,
          "title": "Request Duration Distribution (ms)",
          "type": "heatmap",
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "rate(toopset_request_duration_ms_bucket[5m])",
              "format": "heatmap"
            }
          ]
        },
        {
          "id": 23,
          "title": "Slow Request Rate (>500ms)",
          "type": "timeseries",
          "datasource": "Prometheus",
          "fieldConfig": {
            "defaults": { "unit": "reqps" }
          },
          "targets": [
            {
              "expr": "rate(toopset_request_duration_ms_count[5m]) - rate(toopset_request_duration_ms_bucket{le=\"500\"}[5m])",
              "legendFormat": "slow requests"
            }
          ]
        }
      ]
    }
  ],
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" }
}

{
  "dashboard": {
    "id": null,
    "title": "ToopSet — Application Monitoring",
    "tags": ["toopset", "sports"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 2,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "کاربران",
        "description": "تعداد کل کاربران ثبت‌نام شده",
        "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
        "options": {
          "colorMode": "none",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
          "textMode": "auto"
        },
        "targets": [{ "refId": "A", "expr": "toopset_db_users_total", "instant": true }]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "زمین‌های فعال",
        "description": "تعداد زمین‌های ورزشی فعال",
        "gridPos": { "x": 3, "y": 0, "w": 3, "h": 4 },
        "options": {
          "colorMode": "none",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
          "textMode": "auto"
        },
        "targets": [{ "refId": "A", "expr": "toopset_active_courts_total", "instant": true }]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "رزروهای امروز",
        "description": "تعداد رزروهای ثبت‌شده امروز",
        "gridPos": { "x": 6, "y": 0, "w": 3, "h": 4 },
        "options": {
          "colorMode": "none",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
          "textMode": "auto"
        },
        "targets": [{ "refId": "A", "expr": "toopset_today_bookings_total", "instant": true }]
      },
      {
        "id": 4,
        "type": "stat",
        "title": "درآمد امروز (تومان)",
        "description": "مجموع درآمد تاییدشده امروز",
        "gridPos": { "x": 9, "y": 0, "w": 3, "h": 4 },
        "options": {
          "colorMode": "none",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
          "textMode": "auto"
        },
        "targets": [{ "refId": "A", "expr": "toopset_today_revenue_toman", "instant": true }]
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "مدت زمان پاسخگویی API",
        "description": "صدک‌های p50 / p95 / p99",
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "showPoints": "never",
              "lineInterpolation": "smooth",
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50"
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95"
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "نرخ درخواست‌ها",
        "description": "تعداد درخواست در ثانیه به تفکیک مسیر",
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "showPoints": "never",
              "lineInterpolation": "smooth",
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_requests_total[5m])) by (method, path)",
            "legendFormat": "{{method}} {{path}}"
          }
        ]
      },
      {
        "id": 7,
        "type": "piechart",
        "title": "وضعیت رزروها",
        "description": "توزیع رزروها بر اساس وضعیت",
        "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
        "fieldConfig": {
          "defaults": { "unit": "short" },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "right" },
          "pieType": "pie",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "tooltip": { "mode": "single", "sort": "none" }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "toopset_bookings_by_status",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "id": 8,
        "type": "stat",
        "title": "نرخ خطا",
        "description": "درصد خطاهای 5xx از کل درخواست‌ها",
        "gridPos": { "x": 8, "y": 12, "w": 4, "h": 4 },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 0.01 },
                { "color": "red", "value": 0.05 }
              ]
            }
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_errors_total{status=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))",
            "instant": true
          }
        ]
      },
      {
        "id": 9,
        "type": "stat",
        "title": "نسبت Cache Hit",
        "description": "درصد درخواست‌های کش که با موفقیت برگشتند",
        "gridPos": { "x": 8, "y": 16, "w": 4, "h": 4 },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 0.5 },
                { "color": "green", "value": 0.8 }
              ]
            }
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "toopset_cache_hits_total / (toopset_cache_hits_total + toopset_cache_misses_total)",
            "instant": true
          }
        ]
      },
      {
        "id": 10,
        "type": "table",
        "title": "کندترین اندپوینت‌ها",
        "description": "۵ اندپوینت با بالاترین p99 latency",
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
        "options": {
          "sortBy": [
            { "displayName": "p99" }
          ]
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))",
            "legendFormat": "{{path}}"
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))",
            "legendFormat": "p50 {{path}}"
          }
        ]
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "کش Redis — Hit vs Miss",
        "description": "تعداد درخواست‌های موفق و ناموفق کش",
        "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "showPoints": "never",
              "lineInterpolation": "smooth",
              "spanNulls": false
            }
          }
        },
        "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(toopset_cache_hits_total[5m])",
            "legendFormat": "Hit"
          },
          {
            "refId": "B",
            "expr": "rate(toopset_cache_misses_total[5m])",
            "legendFormat": "Miss"
          }
        ]
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "اتصالات PostgreSQL",
        "description": "تعداد اتصالات فعال دیتابیس از postgres_exporter",
        "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "showPoints": "never",
              "lineInterpolation": "smooth",
              "spanNulls": false
            }
          }
        },
        "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "pg_stat_database_numbackends{datname=~\"toopset.*\"}",
            "legendFormat": "{{datname}}"
          }
        ]
      }
    ]
  }
}

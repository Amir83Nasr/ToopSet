# ══════════════════════════════════════════════════════════════
# ToopSet — Frontend Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this to frontend/.env.local for local development.
# ──────────────────────────────────────────────────────────────

# ── API (backend URL) ────────────────────────────────────────
# For local dev: http://localhost:8000
# For staging: https://your-staging.railway.app
# For production: set in Vercel Production env vars
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Maps ─────────────────────────────────────────────────────
# Get a web API key from https://developers.neshan.org
# NEXT_PUBLIC_NESHAN_API_KEY=web.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Monitoring ───────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=

# ── Service Worker / PWA ─────────────────────────────────────
ENABLE_PWA=true
# ENABLE_PWA_DEV=false

# ── Dev LAN access (comma-separated IPs for HMR) ─────────────
# ALLOWED_DEV_ORIGINS=192.168.1.20

# ── Bundle Analyzer ──────────────────────────────────────────
# ANALYZE=false

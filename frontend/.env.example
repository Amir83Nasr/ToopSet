# ToopSet — Frontend Environment
# Copy to frontend/.env.local for local dev.

# ─── API / MAPS ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_NESHAN_API_KEY=web.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── DEV LAN ACCESS ───────────────────────────────────────
# (comma-separated IPs for HMR)
# ALLOWED_DEV_ORIGINS=192.168.1.20

# ─── MONITORING / ANALYZER ────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# ANALYZE=false

# ─── PWA ──────────────────────────────────────────────────
# ENABLE_PWA=false

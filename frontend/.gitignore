# ────────────────────────────────────────────────────────────
# ToopSet — frontend .gitignore
# ────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ───────────────────────────────────────────────
/.next/
/out/

# ── Build output ──────────────────────────────────────────
/build

# ── Testing ───────────────────────────────────────────────
/coverage

# ── Environment (secrets stay in Vercel dashboard) ────────
.env
.env.local
.env.*.local
.env.production
.env.staging

# ── Debug logs ────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── IDE / Editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────
.DS_Store
*.pem

# ── Misc ──────────────────────────────────────────────────
*.log

# ────────────────────────────────────────────────────────────
# ToopSet — root .gitignore
# ────────────────────────────────────────────────────────────

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
*.so
*.pyc

# ── Node / JavaScript ─────────────────────────────────────
node_modules/
.next/
out/
build/

# ── IDE / Editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
*~

# ── OS ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Environment / Secrets ─────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Backend ───────────────────────────────────────────────
backend/bin/
backend/*.db
backend/.coverage
backend/htmlcov/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.pytest_cache/

# ── Uploads (runtime data) ────────────────────────────────
backend/uploads/*
!backend/uploads/avatars/.gitkeep
!backend/uploads/courts/.gitkeep

# ── Misc ──────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
*.pid
.playwright-mcp/

# ── AI ─────────────────────────────────────────────────────
*-workspace/

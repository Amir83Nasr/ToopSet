# ────────────────────────────────────────────────────────────
# ToopSet — root .gitignore
# ────────────────────────────────────────────────────────────

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
*.so
*.pyc

# ── Node / JavaScript ─────────────────────────────────────
node_modules/
.next/
out/
build/

# ── IDE / Editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
*~

# ── OS ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Environment / Secrets ─────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.*
!.env.example
# Hamravesh compose with real secrets — import manually, never commit
compose-hamravesh.yml
config-toopset.yml
*.pem
*.key

# ── Backend ───────────────────────────────────────────────
db-backups/
bin/
*.db
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# Downloaded API reference docs (Zibal OpenAPI etc.)
backend/api-*.json

# ── Lefthook generated hooks ─────────────────────────────
.git/hooks/pre-commit
.git/hooks/pre-push
.git/hooks/_lefthook*

# ── Uploads (runtime data) ────────────────────────────────
backend/uploads/*
!backend/uploads/avatars/.gitkeep
!backend/uploads/courts/.gitkeep

# ── Misc ──────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
*.pid
.playwright-mcp/
# Serwist build output — `next build` compiles app/sw.ts over the dev stub
frontend/public/sw.js
frontend/public/sw.js.map
frontend/public/swe-worker-*.js

# ── AI ─────────────────────────────────────────────────────
*-workspace/
.claude/

# ── Docs ───────────────────────────────────────────────────
docs/diagrams/
docs/proposals/
docs/scenarios/
docs/icons/mock/
.codewhale/
TODO.md
